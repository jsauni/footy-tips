NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never exposed to the browser. Used for account deletion and
# admin player management (rename / remove).
SUPABASE_SERVICE_ROLE_KEY=

# Error reporting (optional). Sentry stays off when the DSN is empty.
# From Sentry: Project settings -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Share of requests to trace for performance (0 = errors only). e.g. 0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Build-time only, for readable stack traces (source map upload). Set in Vercel.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
